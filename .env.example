# Auth persistence
AUTH_STORAGE_PATH=.storage/auth.json

# Scraping behavior
WAIT_MODE=static
RATE_LIMIT_MS=3000
PARALLEL_WORKERS=2
CHECKPOINT_SAVE_INTERVAL=10

# Export strategies (comma-separated list, e.g., markdown, json)
EXPORT_STRATEGIES=markdown

# Vector search
ENABLE_VECTOR_SEARCH=true

# AI services
# PROVIDER: 'ollama' | 'openai-compatible'
# - ollama: Uses local Ollama server (default)
# - openai-compatible: Uses external API (OpenAI, OpenRouter, DeepSeek, etc.)
AI_PROVIDER=ollama
AI_EMBED_PROVIDER=ollama

# External API Configuration
# Required if using 'openai-compatible' providers
AI_API_KEY=
# Optional: Defaults to https://api.openai.com/v1 if AI_API_KEY is provided
# Set this for OpenRouter (https://openrouter.ai/api/v1), DeepSeek, etc.
AI_BASE_URL=

# Model Names
# If unset, these fall back to OLLAMA_MODEL and OLLAMA_EMBED_MODEL
AI_MODEL=deepseek-r1
AI_EMBED_MODEL=nomic-embed-text

# Ollama Legacy Configuration (Still supported for backward compatibility)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Paths
EXPORT_DIR=exports
CHECKPOINT_PATH=.storage/checkpoint.json
VECTOR_INDEX_PATH=.storage/vector-index

# Browser behavior
# HEADLESS can be 'true', 'false', or 'new'
HEADLESS=false

# Debugging
# Set to 'true' to enable detailed API diagnostic logging in debug/api-diagnostics.jsonl
DEBUG=false

# HyDE (Hypothetical Document Embeddings)
# HYDE_MODE: 'off' | 'fusion' | 'supplement'
# - off: No HyDE is used.
# - fusion: Always use HyDE and fuse with original results (old default).
# - supplement: Only use HyDE if initial results are weak (new default).
HYDE_MODE=supplement
HYDE_THRESHOLD_SCORE=0.7
HYDE_THRESHOLD_COUNT=5
